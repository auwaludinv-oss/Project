cmake_minimum_required(VERSION 3.22)
project(Saturation VERSION 0.1.0)

# Taruh folder JUCE (git clone https://github.com/juce-framework/JUCE) di samping file ini
add_subdirectory(JUCE)

juce_add_plugin(Saturation
    COMPANY_NAME "NamaKamu"
    PLUGIN_MANUFACTURER_CODE Nmkm
    PLUGIN_CODE Satr
    FORMATS VST3 Standalone
    PRODUCT_NAME "Saturation"
    IS_SYNTH FALSE
    NEEDS_MIDI_INPUT FALSE
    NEEDS_MIDI_OUTPUT FALSE)

target_sources(Saturation PRIVATE
    Source/PluginProcessor.cpp
    Source/PluginProcessor.h)

target_compile_definitions(Saturation PUBLIC
    JUCE_WEB_BROWSER=0
    JUCE_USE_CURL=0
    JUCE_VST3_CAN_REPLACE_VST2=0)

target_link_libraries(Saturation
    PRIVATE
        juce::juce_audio_utils
        juce::juce_dsp
    PUBLIC
        juce::juce_recommended_config_flags
        juce::juce_recommended_warning_flags)
